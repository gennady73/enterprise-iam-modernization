# Shell scripts, specs and Containerfiles run inside Linux containers: keep LF
* text=auto
*.sh text eol=lf
*.spec.in text eol=lf
Containerfile.* text eol=lf
*.rpm binary
*.tar binary
# Phase 0 files are copied to RHEL as-is (env, csv, py): always LF
scripts/phase0/** text eol=lf
scripts/phase0/windows/** text eol=crlf
