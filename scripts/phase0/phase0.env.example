# =============================================================================
# Phase 0 sandbox Samba AD DC settings.
# Copy to phase0.env, edit, keep it on the Samba VM only (chmod 600).
# All phase0 scripts read ./phase0.env (or the file named by PHASE0_ENV).
# =============================================================================

# New domain hosted by this Samba DC. It must differ from the source domain
# (e.g. mydomain.com), must not be a subdomain of it, and should be a DNS
# name you control. The NetBIOS name must differ from the source domain's.
REALM="MYDOMAIN2.COM"          # Kerberos realm, upper case
DOMAIN="MYDOMAIN2"             # NetBIOS name, max 15 characters

# This VM
DC_HOSTNAME="dc1"              # short host name, max 15 characters
DC_IP="192.168.100.10"         # static IPv4 already configured on the VM
DNS_FORWARDER="192.168.100.1"  # resolver for other names; use a source-domain (mydomain.com)
                               # DNS server so file-share paths in imported GPOs still resolve

# Samba package (path on this VM)
SAMBA_RPM="/root/samba-ad-dc-4.24.7-2.el9.x86_64.rpm"

# SELinux: "permissive" (default for Phase 0) or "keep" (leave as is).
# The samba-ad-dc package ships no SELinux policy module.
SELINUX_MODE="permissive"

# Where the Windows GPO backups are copied to (04-import-gpos.sh)
GPO_BACKUP_DIR="/root/GPO_Backups"

# OU that test workstations are moved into; imported GPOs are linked here.
TARGET_OU="OU=Dev Workstations"

# The domain Administrator password is NOT stored here.
# 02-provision-dc.sh prompts for it (or reads ADMINPASS from the environment).
